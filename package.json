{
  "name": "file-views",
  "version": "0.1.1",
  "description": "Show a file in a web page by what it is: markdown as a document with mermaid diagrams, CSV with its columns coloured, text and code with numbered lines, pictures, HTML pages in a sandbox, PDF and Word documents as pages.",
  "keywords": [
    "viewer",
    "preview",
    "markdown",
    "mermaid",
    "csv",
    "pdf",
    "docx",
    "html",
    "sandbox"
  ],
  "license": "MIT",
  "author": "Andrei Martyshchenko",
  "homepage": "https://github.com/andrew-mart/file-views#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrew-mart/file-views.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./browser": "./dist/file-views.js",
    "./server": {
      "types": "./types/server/index.d.ts",
      "default": "./src/server/index.js"
    },
    "./styles.css": "./styles/file-views.css",
    "./package.json": "./package.json"
  },
  "files": [
    "src/",
    "dist/",
    "styles/",
    "types/"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs && tsc -p tsconfig.types.json",
    "test": "node --test",
    "check": "tsc -p ."
  },
  "dependencies": {
    "docx-preview": "0.4.0",
    "dompurify": "3.4.16",
    "highlight.js": "11.12.0",
    "jszip": "3.10.2",
    "markdown-it": "15.0.2",
    "mermaid": "11.17.2",
    "pdfjs-dist": "6.3.289"
  },
  "devDependencies": {
    "@types/jsdom": "30.0.0",
    "@types/markdown-it": "14.2.0",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "jsdom": "30.1.2",
    "typescript": "5.9.3"
  }
}
